# Server Environment Configuration

# Application
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3001

# Database (PostgreSQL)
# Format: postgresql://username:password@host:port/database_name?sslmode=disable
DATABASE_URL=postgresql://appuser:secret@localhost:5432/appdb?sslmode=disable

# Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_me_in_production

# Cloudinary (File Upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=lume_ecom_uploads

# Resend & Mail Configuration
RESEND_API_KEY=
MAIL_FROM=E-commerce Store <noreply@talktodoc.online>
MAIL_BRAND_NAME=LUMÉ
MAIL_BRAND_URL=http://localhost:3001
MAIL_SUPPORT_EMAIL=
MAIL_PRIVACY_URL=
MAIL_TERMS_URL=

# SMTP Mail (Alternative to Resend)
MAIL_USER=
MAIL_PASS=

# PayPal Integration
PAYPAL_MODE=sandbox # sandbox or live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# VNPay (Mingo storefront)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3001/checkout/vnpay-return
VNPAY_IPN_URL=http://localhost:3000/payments/vnpay/ipn

# Google Sheets & Shipping Config
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=shipping_config!A2:H1000
SHIPPING_COUNTRY_RANGE=shipping_config!A2:F1000
SHIPPING_CACHE_TTL_MS=600000
SHIPPING_CURRENCY=VND
SHIPPING_METHODS=standard,express
GOOGLE_SHEETS_SECRET_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Mingo fixed-price delivery configuration (Vietnam administrative codes)
MINGO_HOME_PROVINCE_CODE=
MINGO_INNER_DISTRICT_CODES=
MINGO_INNER_CITY_FEE=25000
MINGO_OUTER_CITY_FEE=35000
